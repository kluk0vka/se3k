          "expr": "sum by (response_code) (rate(istio_requests_total{reporter=\"source\",source_workload=\"staybook-gateway-istio\"}[2m]))",
          "legendFormat": "{{response_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Rate-limited share (429)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(rate(istio_requests_total{reporter=\"source\",source_workload=\"staybook-gateway-istio\",response_code=\"429\"}[2m])) / sum(rate(istio_requests_total{reporter=\"source\",source_workload=\"staybook-gateway-istio\"}[2m]))",
          "refId": "A"
        }
      ]
    },
